whitespace=( |\t|\r)*
newline=\n
comment=#

proc=proc
end=end
let=let
bool=false|true
ret=ret
retval=retval
while=while
if=if
elif=elif
else=else
const=const
use=use
super=super
null=null
asm=asm
as=as

oparen=\(
cparen=\)
comma=,
str="
set==
plus=\+
minus=\-
star=\*
slash=/
perc=%
lshift=<<
rshift=>>
and=&
or=\|
xor=^
eq===
ne=!=
ls=<
le=<=
gt=>
ge=>=
arrow=\->
colon=:
coloncolon=::
colonset=:=

int=\-?0-9+
ident=(a-z|A-Z|_)(a-z|A-Z|_|0-9)*
